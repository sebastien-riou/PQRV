# Bare-metal RV32IMC build of ML-DSA (FIPS 204), checked against the
# known-answer test vectors of crypto-benchmark.
#
# The ELF files use the QEMU 'virt' memory map (../../common/rv32_virt). The
# run_kat target runs them with the Unicorn emulator, which is installed in a
# virtual environment (out/venv) on first use.
#
# Usage: make -f Makefile_rv32imc run_kat CROSS_COMPILE=<path>/riscv-none-elf-

CROSS_COMPILE 	?= riscv-none-elf-
CC 				= $(CROSS_COMPILE)gcc

CRYPTO_BENCHMARK_DIR ?= ../../../crypto-benchmark

COMMONDIR 		= ../../common
KECCAKDIR		= ../../sha3
NTTDIR			= ../../ntt/dilithium
VIRTDIR			= $(COMMONDIR)/rv32_virt
TVDIR			= $(CRYPTO_BENCHMARK_DIR)/libmldsa-lbmk/include
SHA2DIR			= $(CRYPTO_BENCHMARK_DIR)/common

VENV_PYTHON		= out/venv/bin/python
PYTHON 			?= $(VENV_PYTHON)

CFLAGS 	= -Wall -Wextra -Wpedantic -Wmissing-prototypes -Wredundant-decls \
		  -Wshadow -Wpointer-arith -O3 -fomit-frame-pointer \
		  -march=rv32imc_zicsr -mabi=ilp32 -mcmodel=medany \
		  -ffunction-sections -fdata-sections \
		  -DRV32=1 -DRV32IMC -DDILITHIUM_COUNT_REJ_NUM \
		  -I. -I$(COMMONDIR) -I$(KECCAKDIR) -I$(NTTDIR) -I$(TVDIR) -I$(SHA2DIR)
LDFLAGS = -nostartfiles -T $(VIRTDIR)/link.ld \
		  --specs=nano.specs --specs=nosys.specs -Wl,--gc-sections \
		  -Wl,--no-warn-rwx-segments

RM = /bin/rm

SOURCES = $(COMMONDIR)/test_kat_mldsa.c \
		  sign.c packing.c polyvec.c poly.c ntt.c reduce.c rounding.c \
		  $(KECCAKDIR)/fips202_rv32.c $(KECCAKDIR)/fips202_rv32im.S \
		  $(NTTDIR)/ntt_dualissue_mont_rv32im.S \
		  $(VIRTDIR)/start.S $(VIRTDIR)/syscalls.c $(SHA2DIR)/sha-256.c
HEADERS = config.h params.h sign.h packing.h polyvec.h poly.h ntt.h reduce.h \
		  rounding.h $(KECCAKDIR)/fips202.h $(NTTDIR)/ntt_rv32im.h \
		  $(COMMONDIR)/randombytes.h $(SHA2DIR)/sha-256.h $(VIRTDIR)/link.ld

.PHONY: all run_kat clean

all: out/test_kat2_rv32imc.elf out/test_kat3_rv32imc.elf out/test_kat5_rv32imc.elf

# % is DILITHIUM_MODE: 2, 3 and 5 are ML-DSA-44, ML-DSA-65 and ML-DSA-87
out/test_kat%_rv32imc.elf: $(SOURCES) $(HEADERS)
	mkdir -p out/
	$(CC) $(CFLAGS) -DDILITHIUM_MODE=$* $(LDFLAGS) \
	  -o $@ $(filter %.c, $^) $(filter %.S, $^)

$(VENV_PYTHON):
	python3 -m venv out/venv
	out/venv/bin/pip install unicorn

run_kat: all $(filter $(VENV_PYTHON), $(PYTHON))
	$(PYTHON) $(VIRTDIR)/run.py out/test_kat2_rv32imc.elf
	$(PYTHON) $(VIRTDIR)/run.py out/test_kat3_rv32imc.elf
	$(PYTHON) $(VIRTDIR)/run.py out/test_kat5_rv32imc.elf

# Keeps out/venv
clean:
	-$(RM) -f out/test_kat*_rv32imc.elf
