#!/bin/bash
# Known-answer test of libpqrv (rv32imc build) against the test vectors of
# crypto-benchmark, run with the Unicorn emulator, which is installed in a
# Python virtual environment (build/venv) on first use.
#
# The rv32imcb build cannot be tested this way: the emulator does not support
# the Zbb extension.
#
# Usage: ./testit
# Environment:
#   CROSS_COMPILE: toolchain prefix (default: riscv-none-elf-)
#   CRYPTO_BENCHMARK_DIR: crypto-benchmark repository (default: ../../crypto-benchmark)

set -euo pipefail

LIBDIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(dirname "$LIBDIR")
CROSS_COMPILE=${CROSS_COMPILE:-riscv-none-elf-}
CRYPTO_BENCHMARK_DIR=${CRYPTO_BENCHMARK_DIR:-$ROOT/../crypto-benchmark}
VIRTDIR=$ROOT/common/rv32_virt
OUT=$LIBDIR/build/rv32imc
VENV=$LIBDIR/build/venv

"$LIBDIR/buildit" rv32imc

mkdir -p "$OUT/test"
"${CROSS_COMPILE}gcc" -Wall -Wextra -Wpedantic -Wmissing-prototypes -Wshadow \
    -O2 -march=rv32imc_zicsr -mabi=ilp32 -mcmodel=medany \
    -ffunction-sections -fdata-sections \
    -I"$LIBDIR/include" \
    -I"$CRYPTO_BENCHMARK_DIR/libmlkem-lbmk/include" \
    -I"$CRYPTO_BENCHMARK_DIR/libmldsa-lbmk/include" \
    -I"$CRYPTO_BENCHMARK_DIR/common" \
    "$LIBDIR/test/test_libpqrv.c" "$CRYPTO_BENCHMARK_DIR/common/sha-256.c" \
    "$VIRTDIR/start.S" "$VIRTDIR/syscalls.c" "$OUT/lib/libpqrv.a" \
    -nostartfiles -T "$VIRTDIR/link.ld" --specs=nano.specs --specs=nosys.specs \
    -Wl,--gc-sections -Wl,--no-warn-rwx-segments \
    -o "$OUT/test/test_libpqrv.elf"

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install unicorn
fi
"$VENV/bin/python" "$VIRTDIR/run.py" "$OUT/test/test_libpqrv.elf"
